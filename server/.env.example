# Server Port
PORT=5000

# Environment Mode
NODE_ENV=development

# Allowed CORS Origin
CORS_ORIGIN=http://localhost:5173

# MongoDB Atlas Connection URI
MONGODB_URI=your_mongodb_atlas_connection_string

# Authentication (JWT)
JWT_SECRET=your_secret_here

# Initial Administrator Credentials
ADMIN_NAME=your_admin_name
ADMIN_EMAIL=your_admin_email@example.com
ADMIN_PASSWORD=your_admin_password

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Gemini AI Service
GEMINI_API_KEY=
# Fast model for QUICK/STUDENT summaries and social outreach (low latency)
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
# Strong model for TECHNICAL summaries, PDF analysis, and fallback
GEMINI_STRONG_MODEL=gemini-3.5-flash

# ── Production Email (Brevo Transactional HTTPS API) ──────────────────────────
# Required when NODE_ENV=production. Brevo is used instead of Gmail SMTP
# because Render Free blocks outbound SMTP ports (25/465/587).
# Sign up at https://www.brevo.com and get your API key from Settings → API Keys.
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER_EMAIL=verify@yourdomain.com
BREVO_SENDER_NAME=POLARIS

# ── Development Email (Nodemailer / Gmail SMTP) ───────────────────────────────
# Used only when NODE_ENV=development. Not required in production.
EMAIL_USER=your_email@gmail.com
EMAIL_APP_PASSWORD=your_email_app_password